<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AuroCI.Core\AuroCI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ToolCommandName>auroci</ToolCommandName>
    <PackageId>AuroCI</PackageId>
    <Version>1.0.0</Version>

    <Authors>Daniil Zhdanov</Authors>
    <Description>A fast, self-contained terminal utility to automatically generate cross-platform CI/CD pipelines.</Description>
    <RepositoryUrl>https://github.com/d4nilx/AuroCI</RepositoryUrl>
    <PackageTags>ci;cd;github-actions;cli;tool;.NET;dotnet</PackageTags>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aci</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

</Project>
