<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AuroCI.Core\AuroCI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <None Include="auroci-logo.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>AuroCI</PackageId>
    <PackageIcon>auroci-logo.png</PackageIcon>
    <Version>1.4.0</Version>

    <Authors>Daniil Zhdanov</Authors>
    <Description>A fast, self-contained terminal utility to automatically generate cross-platform CI/CD pipelines.</Description>
    <RepositoryUrl>https://github.com/d4nilx/AuroCI</RepositoryUrl>
    <PackageTags>ci;cd;github-actions;cli;tool;.NET;dotnet</PackageTags>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aci</ToolCommandName>
    <PackageOutputPath>../nupkg</PackageOutputPath>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
